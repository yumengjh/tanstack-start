{
  "name": "tanstack-start-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "generate:og": "node scripts/generate-og.mjs",
    "generate:site-assets": "node scripts/generate-site-assets.mjs",
    "prebuild": "pnpm generate:site-assets",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-router": "1.170.30",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.47",
    "i18next": "25.10.10",
    "nitro": "3.0.260610-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "16.6.6",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.36",
    "@types/node": "26.5.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
